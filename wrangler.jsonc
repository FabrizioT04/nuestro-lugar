{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Un único Worker sirve la API (/api/*) y los archivos estáticos de React.
  // Mismo dominio = una sola aplicación en Cloudflare Access y sin CORS.
  // Publicado en https://app.nuestro-lugar.workers.dev (subdominio de la cuenta: nuestro-lugar).
  "name": "app",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Las URLs de vista previa por versión no pasarían por la aplicación de Access.
  "preview_urls": false,

  "assets": {
    // React Router decide las rutas del frontend: cualquier ruta desconocida devuelve index.html.
    "not_found_handling": "single-page-application",
    // Las peticiones a /api/* siempre llegan al Worker, nunca a los assets.
    "run_worker_first": ["/api/*"]
  },

  "vars": {
    "ENVIRONMENT": "production"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nuestro-lugar-db",
      "database_id": "5aded9d2-32a4-4c79-88b7-4917ea5924b3",
      "migrations_dir": "migrations"
    }
  ],

  // Fotos y audios. Bucket privado: los archivos solo se sirven a través del Worker.
  // Crear con `npx wrangler r2 bucket create nuestro-lugar-media`.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "nuestro-lugar-media" }],

  // Límites por usuario: subidas de fotos, escrituras (crear, editar, borrar) y búsquedas en Google Places.
  // Protegen D1, R2 y la cuota gratuita de Google ante un bucle del cliente o un abuso.
  "ratelimits": [
    { "name": "UPLOAD_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "WRITE_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "PLACES_LIMITER", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } },
    { "name": "AI_LIMITER", "namespace_id": "1004", "simple": { "limit": 20, "period": 60 } }
  ],

  // Búsqueda de recuerdos con IA (fase 11). Ambos tienen cupo gratis diario; sin pagar,
  // al pasar el cupo responden con error (no cobran) y la app busca por palabras.
  // Crear el índice una vez:
  //   npx wrangler vectorize create nuestro-lugar-memories --dimensions=1024 --metric=cosine
  //   npx wrangler vectorize create-metadata-index nuestro-lugar-memories --propertyName=relationshipId --type=string
  "ai": { "binding": "AI" },
  "vectorize": [{ "binding": "MEMORY_INDEX", "index_name": "nuestro-lugar-memories" }]
}
