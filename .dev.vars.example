# Copia este archivo como .dev.vars para desarrollo local (nunca lo subas a git).
# En producción estos valores se configuran con `npx wrangler secret put NOMBRE`.
ENVIRONMENT=development

# Los dos únicos correos que pueden entrar, separados por coma.
ALLOWED_EMAILS=tu-correo@gmail.com,correo-pareja@gmail.com

# Solo en local: no hay Cloudflare Access delante de `npm run dev`, así que la app
# actúa como si hubieras entrado con este correo. Cámbialo por el de tu pareja para
# probar su vista, o por otro correo para ver la pantalla de acceso denegado.
DEV_USER_EMAIL=tu-correo@gmail.com

# En producción (no hacen falta en local):
# ACCESS_TEAM_DOMAIN=https://<tu-equipo>.cloudflareaccess.com
# ACCESS_AUD=<Application Audience (AUD) Tag de la aplicación en Cloudflare Access>

# Fase 10 (recomendaciones):
# GOOGLE_PLACES_API_KEY=

# Fase 13 (notificaciones push): genera las dos con `npm run push:claves` y cópialas de .push-claves.json.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
